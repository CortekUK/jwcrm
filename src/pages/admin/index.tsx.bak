import { ProtectedRoute } from "@/components/ProtectedRoute";
import { AdminLayout } from "@/components/layouts/AdminLayout";
import { useEffect, useState } from "react";
import { supabase } from "@/integrations/supabase/client";
import { toast } from "@/hooks/use-toast";
import Link from "next/link";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Avatar, AvatarFallback } from "@/components/ui/avatar";
import { Badge } from "@/components/ui/badge";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Users,
  FileText,
  FolderCheck,
  CheckCircle2,
  Mail,
  Calendar,
  Loader2,
  ExternalLink,
  Clock,
  Search,
  LayoutDashboard,
  AlertCircle
} from "lucide-react";
import { useAuth } from "@/hooks/useAuth";
import { format } from "date-fns";
import { useTranslation } from "react-i18next";
import { clientStatusMap } from "@/lib/status-config";
import { UserDocumentManagementModal } from "@/components/admin/UserDocumentManagementModal";
import { useAdminStore } from "@/stores/adminStore";

function AdminDashboard() {
  const { profile } = useAuth();
  const { t } = useTranslation(['admin', 'common', 'toast']);
  const [users, setUsers] = useState<UserProfile[]>([]);
  const [stats, setStats] = useState<Stats>({
    totalUsers: 0,
    totalWills: 0,
    draftsGenerated: 0,
    finalizedWills: 0,
    clientReviews: 0,
    clientApproved: 0,
  });
  const [activities, setActivities] = useState<ActivityEvent[]>([]);
  const [loading, setLoading] = useState(true);
  const [searchQuery, setSearchQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [documentModalOpen, setDocumentModalOpen] = useState(false);
  const [selectedUser, setSelectedUser] = useState<{ id: string; name: string } | null>(null);

  const getStatusLabel = (status: string) => {
    const statusKey = status as keyof typeof clientStatusMap;

    // Map status to translation key
    const statusTranslationMap: Record<string, string> = {
      'in_progress': 'inProgressStatus',
      'awaiting_review': 'awaitingReviewStatus',
      'under_review': 'underReviewStatus',
      'draft_ready': 'draftReadyStatus',
      'draft_released': 'draftReleasedStatus',
      'finalized': 'finalizedStatus',
    };

    const translationKey = statusTranslationMap[status];
    return translationKey ? t(`admin:${translationKey}`) : clientStatusMap[statusKey]?.label || status;
  };

  const fetchData = async () => {
      try {
        // Fetch all users (including admins)
        const { data: profilesData, error: profilesError } = await supabase
          .from('profiles')
          .select('user_id, full_name, locale, created_at')
          .order('created_at', { ascending: false });

        if (profilesError) throw profilesError;

        const usersWithDetails: UserProfile[] = profilesData || [];

        // Get will counts for each user (only submitted wills)
        const userIds = usersWithDetails.map(u => u.user_id);
        const { data: willsData } = await supabase
          .from('wills')
          .select('user_id, status, client_approval_status')
          .in('user_id', userIds)
          .not('submitted_at', 'is', null);

        // Count wills per user
        const willCounts: Record<string, number> = {};
        const reviewsCounts: Record<string, number> = {};
        const approvedCounts: Record<string, number> = {};

        willsData?.forEach(will => {
          willCounts[will.user_id] = (willCounts[will.user_id] || 0) + 1;

          if (will.client_approval_status === 'disapproved') {
            reviewsCounts[will.user_id] = (reviewsCounts[will.user_id] || 0) + 1;
          }

          if (will.client_approval_status === 'approved') {
            approvedCounts[will.user_id] = (approvedCounts[will.user_id] || 0) + 1;
          }
        });

        // Get document counts for each user
        const { data: documentsData } = await supabase
          .from('user_identity_documents')
          .select('user_id')
          .in('user_id', userIds);

        const documentsCounts: Record<string, number> = {};
        documentsData?.forEach(doc => {
          documentsCounts[doc.user_id] = (documentsCounts[doc.user_id] || 0) + 1;
        });

        const enrichedUsers = usersWithDetails.map(user => ({
          ...user,
          willsCount: willCounts[user.user_id] || 0,
          reviewsCount: reviewsCounts[user.user_id] || 0,
          approvedCount: approvedCounts[user.user_id] || 0,
          documentsCount: documentsCounts[user.user_id] || 0,
        }));

        // Filter out admins - only show clients
        const { data: userRolesData } = await supabase
          .from('user_roles')
          .select('user_id, role')
          .in('user_id', userIds);

        const adminUserIds = new Set(
          userRolesData
            ?.filter(ur => ur.role === 'admin')
            .map(ur => ur.user_id) || []
        );

        const clientUsers = enrichedUsers.filter(user => !adminUserIds.has(user.user_id));

        setUsers(clientUsers);

        // Fetch stats (only count client users, not admins)
        const usersCount = clientUsers.length;

        const { count: willsCount } = await supabase
          .from('wills')
          .select('*', { count: 'exact', head: true })
          .not('submitted_at', 'is', null);

        const { count: draftsCount } = await supabase
          .from('wills')
          .select('*', { count: 'exact', head: true })
          .eq('status', 'draft_released');

        const { count: finalizedCount } = await supabase
          .from('wills')
          .select('*', { count: 'exact', head: true })
          .eq('status', 'finalized');

        const { count: clientReviewsCount } = await supabase
          .from('wills')
          .select('*', { count: 'exact', head: true })
          .eq('client_approval_status', 'disapproved');

        const { count: clientApprovedCount } = await supabase
          .from('wills')
          .select('*', { count: 'exact', head: true })
          .eq('client_approval_status', 'approved');

        setStats({
          totalUsers: usersCount,
          totalWills: willsCount || 0,
          draftsGenerated: draftsCount || 0,
          finalizedWills: finalizedCount || 0,
          clientReviews: clientReviewsCount || 0,
          clientApproved: clientApprovedCount || 0,
        });

        // Fetch recent activity
        const { data: activityData } = await supabase
          .from('will_status_events')
          .select(`
            id,
            will_id,
            new_status,
            changed_at,
            notes,
            actor_user_id
          `)
          .order('changed_at', { ascending: false })
          .limit(10);

        // Get actor names
        if (activityData) {
          const actorIds = [...new Set(activityData.map(a => a.actor_user_id))];
          const { data: actorsData } = await supabase
            .from('profiles')
            .select('user_id, full_name')
            .in('user_id', actorIds);

          const actorNames: Record<string, string> = {};
          actorsData?.forEach(actor => {
            actorNames[actor.user_id] = actor.full_name || 'Unknown';
          });

          const enrichedActivities = activityData.map(activity => ({
            ...activity,
            actor_name: actorNames[activity.actor_user_id] || 'System',
          }));

          setActivities(enrichedActivities);
        }
      } catch (error) {
        console.error('Error fetching admin data:', error);
        toast({
          variant: "destructive",
          title: t('toast:error'),
          description: t('toast:admin.errorLoadingDashboard'),
        });
      } finally {
        setLoading(false);
      }
    };

  useEffect(() => {
    fetchData();
  }, []);

  const getInitials = (name: string | null) => {
    if (!name) return "U";
    return name
      .split(" ")
      .map((n) => n[0])
      .join("")
      .toUpperCase()
      .slice(0, 2);
  };

  const getStatusBadge = (status: string) => {
    return (
      <Badge
        className="bg-[rgba(12,85,54,0.08)] text-[#0C5536] border border-[#C6A03B] rounded-md font-medium hover:bg-[rgba(12,85,54,0.12)] transition-colors"
      >
        {t('admin:active')}
      </Badge>
    );
  };

  const filteredUsers = users.filter(user => {
    const matchesSearch = user.full_name?.toLowerCase().includes(searchQuery.toLowerCase()) || 
                         user.email?.toLowerCase().includes(searchQuery.toLowerCase());
    return matchesSearch;
  });

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[400px]">
        <Loader2 className="h-8 w-8 animate-spin text-accent" />
      </div>
    );
  }

  return (
    <div className="space-y-8 pb-12">
      {/* Hero Header */}
      <div className="bg-gradient-to-b from-white to-[#F8F6EC] border-b-2 border-[hsl(var(--jw-gold-accent))]/25 mb-6 -mx-6 -mt-6 px-6 py-8 lg:-mx-8 lg:-mt-8 lg:px-8 animate-fade-in">
        <div className="flex items-center justify-between">
          <div>
            <div className="flex items-center gap-3 mb-2">
              <LayoutDashboard className="h-6 w-6 text-[hsl(var(--jw-gold-accent))]" />
              <h1 className="text-2xl font-semibold text-[hsl(var(--jw-primary-green))]" style={{ fontFamily: 'Playfair Display, serif' }}>
                {t('admin:adminDashboard')}
              </h1>
            </div>
            <p className="text-sm text-[#777777] ltr:ml-9 rtl:mr-9">
              {t('admin:manageClientsWillsDocuments')}
            </p>
          </div>

          {(stats.clientReviews > 0 || stats.clientApproved > 0) && (
            <Link href="/admin/wills?filter=client_review">
              <div className="flex items-center gap-3 px-3 py-2 bg-white border border-[#E6E6E4] rounded-md hover:border-[#C6A03B] transition-all cursor-pointer">
                <AlertCircle className="h-4 w-4 text-[#777777]" />
                <div className="flex items-center gap-3 text-sm">
                  {stats.clientReviews > 0 && (
                    <span className="text-[#DC2626] font-medium">
                      {stats.clientReviews} changes
                    </span>
                  )}
                  {stats.clientReviews > 0 && stats.clientApproved > 0 && (
                    <span className="text-[#E6E6E4]">|</span>
                  )}
                  {stats.clientApproved > 0 && (
                    <span className="text-[#16A34A] font-medium">
                      {stats.clientApproved} {t('admin:approvedBadge')}
                    </span>
                  )}
                </div>
              </div>
            </Link>
          )}
        </div>
      </div>

      {/* Quick Stats */}
      <div className="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <Card className="rounded-lg border border-[#E6E6E4] hover:shadow-[0_2px_8px_rgba(198,160,59,0.08)] transition-all duration-100 group">
          <CardHeader className="pb-3">
            <div className="flex items-center justify-between">
              <CardTitle className="text-sm font-medium text-[#777777]">
                {t('admin:totalUsers')}
              </CardTitle>
              <div className="flex h-12 w-12 items-center justify-center rounded-full" style={{ backgroundColor: 'rgba(198, 160, 59, 0.15)' }}>
                <Users className="h-5 w-5 text-[#0C5536]" />
              </div>
            </div>
          </CardHeader>
          <CardContent>
            <div className="text-3xl font-bold tracking-tight text-[#222222]">
              {stats.totalUsers}
            </div>
            <p className="text-xs text-[#777777] mt-2">
              {t('admin:registeredClients')}
            </p>
            <div className="h-0.5 w-0 group-hover:w-full bg-[#C6A03B] transition-all duration-300 mt-3"></div>
          </CardContent>
        </Card>

        <Card className="rounded-lg border border-[#E6E6E4] hover:shadow-[0_2px_8px_rgba(198,160,59,0.08)] transition-all duration-100 group">
          <CardHeader className="pb-3">
            <div className="flex items-center justify-between">
              <CardTitle className="text-sm font-medium text-[#777777]">
                {t('admin:totalWills')}
              </CardTitle>
              <div className="flex h-12 w-12 items-center justify-center rounded-full" style={{ backgroundColor: 'rgba(198, 160, 59, 0.15)' }}>
                <FileText className="h-5 w-5 text-[#0C5536]" />
              </div>
            </div>
          </CardHeader>
          <CardContent>
            <div className="text-3xl font-bold tracking-tight text-[#222222]">
              {stats.totalWills}
            </div>
            <p className="text-xs text-[#777777] mt-2">
              {t('admin:allWillSubmissions')}
            </p>
            <div className="h-0.5 w-0 group-hover:w-full bg-[#C6A03B] transition-all duration-300 mt-3"></div>
          </CardContent>
        </Card>

        <Card className="rounded-lg border border-[#E6E6E4] hover:shadow-[0_2px_8px_rgba(198,160,59,0.08)] transition-all duration-100 group">
          <CardHeader className="pb-3">
            <div className="flex items-center justify-between">
              <CardTitle className="text-sm font-medium text-[#777777]">
                {t('admin:draftsGenerated')}
              </CardTitle>
              <div className="flex h-12 w-12 items-center justify-center rounded-full" style={{ backgroundColor: 'rgba(198, 160, 59, 0.15)' }}>
                <FolderCheck className="h-5 w-5 text-[#0C5536]" />
              </div>
            </div>
          </CardHeader>
          <CardContent>
            <div className="text-3xl font-bold tracking-tight text-[#222222]">
              {stats.draftsGenerated}
            </div>
            <p className="text-xs text-[#777777] mt-2">
              {t('admin:draftPdfsCreated')}
            </p>
            <div className="h-0.5 w-0 group-hover:w-full bg-[#C6A03B] transition-all duration-300 mt-3"></div>
          </CardContent>
        </Card>

        <Card className="rounded-lg border border-[#E6E6E4] hover:shadow-[0_2px_8px_rgba(198,160,59,0.08)] transition-all duration-100 group">
          <CardHeader className="pb-3">
            <div className="flex items-center justify-between">
              <CardTitle className="text-sm font-medium text-[#777777]">
                {t('admin:finalizedWills')}
              </CardTitle>
              <div className="flex h-12 w-12 items-center justify-center rounded-full" style={{ backgroundColor: 'rgba(198, 160, 59, 0.15)' }}>
                <CheckCircle2 className="h-5 w-5 text-[#0C5536]" />
              </div>
            </div>
          </CardHeader>
          <CardContent>
            <div className="text-3xl font-bold tracking-tight text-[#222222]">
              {stats.finalizedWills}
            </div>
            <p className="text-xs text-[#777777] mt-2">
              {t('admin:completedWills')}
            </p>
            <div className="h-0.5 w-0 group-hover:w-full bg-[#C6A03B] transition-all duration-300 mt-3"></div>
          </CardContent>
        </Card>
      </div>

      <div className="grid gap-6 lg:grid-cols-3">
        {/* Users Table */}
        <Card className="rounded-lg max-h-[600px] overflow-auto border border-[#E6E6E4] shadow-[0_4px_10px_rgba(12,85,54,0.06)] lg:col-span-2">
          <CardHeader>
            <div className="flex items-center justify-between mb-4">
              <div>
                <CardTitle className="text-xl font-semibold text-[#0C5536]" style={{ fontFamily: 'Playfair Display, serif' }}>
                  {t('admin:users')}
                </CardTitle>
                <CardDescription className="text-sm text-[#777777]">
                  {t('admin:manageRegisteredClients')}
                </CardDescription>
              </div>
              <Link href="/admin/wills">
                <Button
                  variant="outline"
                  size="sm"
                  className="border-[#0C5536] text-[#0C5536] hover:bg-[#0C5536] hover:text-white transition-all duration-150"
                >
                  {t('admin:viewAllWills')}
                  <ExternalLink className="ltr:ml-2 rtl:mr-2 h-4 w-4" />
                </Button>
              </Link>
            </div>
            
            {/* Search and Filter Bar */}
            <div className="flex gap-3 items-center">
              <div className="flex-1 relative">
                <Search className="absolute ltr:left-3 rtl:right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-[#C6A03B]" />
                <input
                  type="text"
                  placeholder={t('admin:searchClientsPlaceholder')}
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  className="w-full ltr:pl-10 rtl:pr-10 ltr:pr-4 rtl:pl-4 py-2 text-sm border border-[#E6E6E4] rounded-md focus:outline-none focus:border-[#C6A03B] focus:ring-1 focus:ring-[#C6A03B] transition-all"
                />
              </div>
            </div>
          </CardHeader>
          <CardContent>
            <div className="rounded-lg border border-[#E6E6E4] overflow-hidden">
              <Table>
                <TableHeader>
                  <TableRow className="bg-[#FAFAF8]" style={{ borderBottom: '1px solid #EAEAE8' }}>
                    <TableHead className="font-semibold text-[#555555]" style={{ borderRight: '1px solid #EAEAE8' }}>{t('admin:user')}</TableHead>
                    <TableHead className="font-semibold text-[#555555]" style={{ borderRight: '1px solid #EAEAE8' }}>{t('admin:wills')}</TableHead>
                    <TableHead className="font-semibold text-[#555555]" style={{ borderRight: '1px solid #EAEAE8' }}>{t('admin:createdAt')}</TableHead>
                    <TableHead className="font-semibold text-[#555555]" style={{ borderRight: '1px solid #EAEAE8' }}>{t('admin:status')}</TableHead>
                    <TableHead className="font-semibold text-[#555555]" style={{ borderRight: '1px solid #EAEAE8' }}>Reviews</TableHead>
                    <TableHead className="ltr:text-right rtl:text-left font-semibold text-[#555555]">{t('admin:actions')}</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {filteredUsers.length === 0 ? (
                    <TableRow>
                      <TableCell colSpan={6} className="text-center py-8 text-[#777777]">
                        {searchQuery ? t('admin:noUsersMatch') : t('admin:noUsersFound')}
                      </TableCell>
                    </TableRow>
                  ) : (
                    filteredUsers.map((user) => (
                      <TableRow 
                        key={user.user_id} 
                        className="transition-colors hover:bg-[#FDFBF4]"
                        style={{ borderBottom: '1px solid #EAEAE8' }}
                      >
                        <TableCell style={{ borderRight: '1px solid #EAEAE8' }}>
                          <div className="flex items-center gap-3">
                            <Avatar className="h-9 w-9 border-2 border-[#C6A03B]/20">
                              <AvatarFallback className="bg-[rgba(198,160,59,0.15)] text-[#0C5536] text-sm font-semibold">
                                {getInitials(user.full_name)}
                              </AvatarFallback>
                            </Avatar>
                            <div>
                              <p className="font-medium text-[#222222]">
                                {user.full_name || t('admin:unknownUser')}
                              </p>
                              {user.email && (
                                <p className="text-xs text-[#777777] flex items-center gap-1">
                                  <Mail className="h-3 w-3 shrink-0" />
                                  {user.email}
                                </p>
                              )}
                            </div>
                          </div>
                        </TableCell>
                        <TableCell style={{ borderRight: '1px solid #EAEAE8' }}>
                          <Badge className="rounded-md bg-[rgba(12,85,54,0.08)] text-[#0C5536] border-0">
                            {user.willsCount || 0}
                          </Badge>
                        </TableCell>
                        <TableCell style={{ borderRight: '1px solid #EAEAE8' }}>
                          <div className="flex items-center gap-2 text-sm text-[#777777]">
                            <Calendar className="h-4 w-4" />
                            {format(new Date(user.created_at), 'PP')}
                          </div>
                        </TableCell>
                        <TableCell style={{ borderRight: '1px solid #EAEAE8' }}>
                          {getStatusBadge('active')}
                        </TableCell>
                        <TableCell style={{ borderRight: '1px solid #EAEAE8' }}>
                          {(user.reviewsCount || 0) > 0 || (user.approvedCount || 0) > 0 ? (
                            <Link href={`/admin/wills?user=${user.user_id}&filter=client_review`}>
                              <div className="flex items-center gap-3 px-3 py-1.5 bg-white border border-[#E6E6E4] rounded-md hover:border-[#C6A03B] transition-all cursor-pointer">
                                <AlertCircle className="h-3.5 w-3.5 text-[#777777]" />
                                <div className="flex items-center gap-2 text-xs">
                                  {(user.reviewsCount || 0) > 0 && (
                                    <span className="text-[#DC2626] font-medium">
                                      {user.reviewsCount} changes
                                    </span>
                                  )}
                                  {(user.reviewsCount || 0) > 0 && (user.approvedCount || 0) > 0 && (
                                    <span className="text-[#E6E6E4]">|</span>
                                  )}
                                  {(user.approvedCount || 0) > 0 && (
                                    <span className="text-[#16A34A] font-medium">
                                      {user.approvedCount} {t('admin:approvedBadge')}
                                    </span>
                                  )}
                                </div>
                              </div>
                            </Link>
                          ) : (
                            <span className="text-xs text-[#A0A0A0]">-</span>
                          )}
                        </TableCell>
                        <TableCell className="ltr:text-right rtl:text-left">
                          <div className="flex gap-2 justify-end">
                            <Link href={`/admin/wills?user=${user.user_id}`}>
                              <Button
                                variant="outline"
                                size="sm"
                                className="text-xs border-[#0C5536] text-[#0C5536] hover:bg-[#0C5536] hover:text-white transition-all duration-150 px-4 py-1.5 w-[100px]"
                              >
                                {t('admin:viewWills')}
                              </Button>
                            </Link>
                            <Button
                              variant="outline"
                              size="sm"
                              onClick={() => {
                                setSelectedUser({ id: user.user_id, name: user.full_name || t('admin:unknownUser') });
                                setDocumentModalOpen(true);
                              }}
                              className="text-xs border-[#C6A03B] text-[#C6A03B] hover:bg-[#C6A03B] hover:text-white transition-all duration-150 px-4 py-1.5 w-[100px]"
                            >
                              {(user.documentsCount || 0) > 0 ? t('admin:viewDocs') : t('admin:addDocs')}
                            </Button>
                          </div>
                        </TableCell>
                      </TableRow>
                    ))
                  )}
                </TableBody>
              </Table>
            </div>
          </CardContent>
        </Card>

        {/* Recent Activity */}
        <Card className="rounded-lg max-h-[600px] overflow-auto border border-[#E6E6E4] shadow-[0_4px_10px_rgba(12,85,54,0.06)]">
          <CardHeader>
            <CardTitle className="text-xl font-semibold text-[#0C5536]" style={{ fontFamily: 'Playfair Display, serif' }}>
              {t('admin:recentActivity')}
            </CardTitle>
            <CardDescription className="text-sm text-[#777777]">
              {t('admin:latestStatusChanges')}
            </CardDescription>
          </CardHeader>
          <CardContent>
            {activities.length === 0 ? (
              <div className="flex flex-col items-center justify-center py-8 text-center border border-[#E6E6E4] rounded-lg">
                <div className="flex h-12 w-12 items-center justify-center rounded-full mb-3" style={{ backgroundColor: 'rgba(198, 160, 59, 0.15)' }}>
                  <Clock className="h-6 w-6 text-[#C6A03B]" />
                </div>
                <p className="text-sm font-medium text-[#555555]">{t('admin:noRecentActivity')}</p>
                <p className="text-xs text-[#777777] mt-1 max-w-[240px]">
                  {t('admin:updatesWillAppear')}
                </p>
              </div>
            ) : (
              <div className="relative ltr:pl-6 rtl:pr-6">
                {/* Gold timeline line */}
                <div className="absolute ltr:left-2 rtl:right-2 top-2 bottom-2 w-0.5 bg-[#C6A03B]/30"></div>
                
                <div className="space-y-6">
                  {activities.map((activity, index) => (
                    <div
                      key={activity.id}
                      className="relative"
                      style={{ animation: `slideIn 0.3s ease-out ${index * 0.05}s backwards` }}
                    >
                      {/* Gold dot */}
                      <div className="absolute ltr:-left-4 rtl:-right-4 top-1 h-3 w-3 rounded-full bg-[#C6A03B] border-2 border-white"></div>
                      
                      <div className="space-y-1">
                        <p className="text-sm font-medium text-[#0C5536]">
                          {t('admin:statusChangedTo')}{' '}
                          <span className="font-semibold">{getStatusLabel(activity.new_status)}</span>
                        </p>
                        <p className="text-xs text-[#777777]">
                          {t('admin:by')} {activity.actor_name}
                        </p>
                        {activity.notes && (
                          <p className="text-xs text-[#777777] italic">
                            {activity.notes}
                          </p>
                        )}
                        <p className="text-xs text-[#A0A0A0]">
                          {format(new Date(activity.changed_at), 'PPp')}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </CardContent>
        </Card>
      </div>

      {/* Footer Legal Notice */}
      <div className="mt-12 pt-6 border-t border-[#E6E6E4] text-center">
        <p className="text-xs text-[#777777]">
          {t('admin:legalNotice')}
        </p>
      </div>

      {/* User Document Management Modal */}
      {selectedUser && (
        <UserDocumentManagementModal
          isOpen={documentModalOpen}
          onClose={() => {
            setDocumentModalOpen(false);
            setSelectedUser(null);
            // Refresh users to update document counts
            fetchData();
          }}
          userId={selectedUser.id}
          userName={selectedUser.name}
        />
      )}
    </div>
  );
}

export default function Admin() {
  return (
    <ProtectedRoute requiredRole="admin">
      <AdminLayout>
        <AdminDashboard />
      </AdminLayout>
    </ProtectedRoute>
  );
}
