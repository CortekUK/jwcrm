import { useEffect, useState } from "react";
import { useRouter } from "next/router";
import { Button } from "@/components/ui/button";
import { useTranslation } from "react-i18next";
import { AuthLayout } from "@/components/auth/AuthLayout";
import { CheckCircle2, ArrowRight } from "lucide-react";
import { cn } from "@/lib/utils";

export default function AuthVerified() {
  const [countdown, setCountdown] = useState(5);
  const router = useRouter();
  const { t } = useTranslation('auth');

  useEffect(() => {
    // Countdown timer
    if (countdown > 0) {
      const timer = setTimeout(() => setCountdown(countdown - 1), 1000);
      return () => clearTimeout(timer);
    } else {
      // Auto-redirect to portal after countdown
      router.push('/portal');
    }
  }, [countdown, router]);

  const handleGoToPortal = () => {
    router.push('/portal');
  };

  return (
    <AuthLayout>
      <div className="space-y-8 text-center animate-fade-in-up">
        {/* Animated Checkmark Icon */}
        <div className="relative animate-scale-in">
          <div className="w-[70px] h-[70px] rounded-full bg-[#0C5536] flex items-center justify-center shadow-[0_0_10px_rgba(198,160,59,0.25)] mx-auto">
            <CheckCircle2 className="h-9 w-9 text-[#C6A03B]" strokeWidth={2.5} />
          </div>
        </div>

        {/* Title with gold underline */}
        <div className="space-y-3 relative">
          <h1 className="text-[22px] font-serif font-semibold tracking-tight text-[#0C5536]">
            {t('verifiedTitle')}
          </h1>
          <div className="w-16 h-[2px] bg-gradient-to-r from-transparent via-[#C6A03B] to-transparent mx-auto" />
          <p className="text-[14px] text-[#555555] leading-[1.6] max-w-sm mx-auto">
            {t('verifiedSubtitle')}
          </p>
        </div>

        {/* Primary CTA Button */}
        <Button
          onClick={handleGoToPortal}
          className={cn(
            "w-[80%] h-[46px] bg-[#0C5536] text-white rounded-md mx-auto",
            "font-semibold text-[15px]",
            "hover:bg-[#09422A] hover:shadow-[0_0_6px_rgba(198,160,59,0.45)]",
            "focus:ring-2 focus:ring-[#C6A03B] focus:ring-offset-2",
            "transition-all duration-200 transform hover:-translate-y-0.5"
          )}
        >
          {t('goToPortal')}
          <ArrowRight className="ml-2 h-4 w-4" />
        </Button>

        {/* Auto-redirect message with countdown */}
        <div className="space-y-2">
          <p className="text-[12px] text-[#777777]">
            {t('autoRedirectMessage')} {countdown} {countdown === 1 ? 'second' : 'seconds'}...
          </p>

          {/* Progress bar */}
          <div className="w-[80%] mx-auto h-1 bg-[#F0F0F0] rounded-full overflow-hidden">
            <div
              className="h-full bg-gradient-to-r from-[#0C5536] to-[#C6A03B] transition-all duration-1000 ease-linear"
              style={{ width: `${((5 - countdown) / 5) * 100}%` }}
            />
          </div>
        </div>

        {/* Optional support link */}
        <div className="pt-2">
          <p className="text-[13px] text-[#555555]">
            {t('needHelpSigningIn')}{' '}
            <a
              href="/portal/support"
              className="text-[#0C5536] hover:text-[#C6A03B] font-medium transition-colors duration-200"
            >
              {t('contactSupport')}
            </a>
          </p>
        </div>

        {/* Security footer with gold divider */}
        <div className="pt-4 mt-2 border-t border-[#E6E6E4] relative">
          <div className="absolute top-0 left-1/2 -translate-x-1/2 w-16 h-[2px] bg-gradient-to-r from-transparent via-[#C6A03B]/20 to-transparent" />
          <p className="text-[12px] text-[#6B6B6B] leading-[1.4] mt-4">
            🔒 Your details are encrypted and stored securely in compliance with Just Wills' privacy policy.
          </p>
        </div>
      </div>
    </AuthLayout>
  );
}
